# Local development. On Vercel replace both URLs with your hosted PostgreSQL URLs.
# DATABASE_URL: pooled connection for application queries.
# DIRECT_URL: direct connection for Prisma migrations.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/retail_learning?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/retail_learning?schema=public"
# Generate a private value: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=""
NEXT_PUBLIC_APP_NAME="Портал Навчання"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# On Vercel set NEXT_PUBLIC_APP_URL to your actual HTTPS production domain.
# Set PORTAL_RUN_MIGRATIONS=true only in the intended Vercel project's
# Production environment to apply committed migrations before publishing.
# Neon DATABASE_URL_UNPOOLED is accepted as DIRECT_URL during the Vercel build.
# Uploads on Vercel require a connected PRIVATE Blob store.
# Use BLOB_READ_WRITE_TOKEN, or connected-store BLOB_STORE_ID + VERCEL_OIDC_TOKEN.
